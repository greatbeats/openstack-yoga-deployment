# Copy to ~/storage_yoga.env and chmod 600; use fresh disposable Ubuntu 22.04 lab host.
CONFIRM_FRESH_HOST=NO
CONTROLLER_IP=192.0.2.81
STORAGE_IP=192.0.2.83
MGMT_IF=enp1s0
REGION=RegionOne
RABBIT_USER=openstack
RABBIT_PASS="<ENTER_RABBIT_PASS>"
CINDER_PASS="<ENTER_CINDER_PASS>"
CINDER_DB_PASS="<ENTER_CINDER_DB_PASS>"
VOLUME_GROUP=ubuntu-vg
BACKEND_SECTION=lvm
# Do NOT create/destroy any PV, VG, LV, filesystem or disk. OS must be provisioned separately.
