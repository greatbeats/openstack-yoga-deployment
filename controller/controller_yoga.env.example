# Copy to ~/controller_yoga.env; chmod 600; replace each <ENTER_...> placeholder with a password of any nonzero length (letters, digits, _ or -).
# THESE VALUES ARE PLACEHOLDERS, NOT LIVE CREDENTIALS. RUN ON A FRESH TEST LAB HOST ONLY.
# Only set YES_FRESH_HOST on a NEW disposable lab VM.
CONFIRM_FRESH_HOST=NO
CONTROLLER_IP=192.0.2.81
MGMT_IF=enp1s0
PROVIDER_IF=enp4s0
HORIZON_ALLOWED_HOST=192.0.2.81
PROVIDER_CIDR=192.168.100.0/24
PROVIDER_GATEWAY=192.168.100.1
PROVIDER_DNS=8.8.8.8
PROVIDER_POOL_START=192.168.100.100
PROVIDER_POOL_END=192.168.100.200
# To use no-argument one-shot installation including provider network creation, confirm physical/virtual L2 gateway first.
CONFIRM_PROVIDER_PHYSICAL_NET=NO
ADMIN_PASS="<ENTER_ADMIN_PASS>"
DB_PASS="<ENTER_DB_PASS>"
RABBIT_PASS="<ENTER_RABBIT_PASS>"
SERVICE_PASS="<ENTER_SERVICE_PASS>"
METADATA_SECRET="<ENTER_METADATA_SECRET>"

# Notification emission is enabled on Controller Nova and Cinder automatically.
# Agent queue binding is OPT-IN: confirm queue/exchange/vhost and active consumer first.
# This only binds an AMQP queue; it does NOT deploy Agent, Neo4j or detection logic.
ENABLE_NOTIFICATION_QUEUE_BINDING=NO
NOTIFY_VHOST=/
NOTIFY_EXCHANGE=openstack
NOTIFY_QUEUE=cto.openstack.notifications
NOTIFY_ROUTING_KEYS=notifications.info
